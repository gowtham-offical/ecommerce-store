# Copy this file to .env and fill in your own values

# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/ecommerce-store
# Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/ecommerce-store
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce-store

# Secret used to sign JWT tokens (use a long random string in production)
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the backend server will run on
PORT=5000
